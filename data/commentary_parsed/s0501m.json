{
  "id": "s0501m",
  "title_pali": "s0501m",
  "collection": "canon",
  "segments": [
    {
      "id": "s0501m:1",
      "pali": "Namo tassa bhagavato arahato sammāsambuddhassa"
    },
    {
      "id": "s0501m:2",
      "pali": "1. Saraṇattayaṃ"
    },
    {
      "id": "s0501m:3",
      "pali": "Buddhaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:4",
      "pali": "Dhammaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:5",
      "pali": "Saṅghaṃ saraṇaṃ gacchāmi."
    },
    {
      "id": "s0501m:6",
      "pali": "Dutiyampi buddhaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:7",
      "pali": "Dutiyampi dhammaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:8",
      "pali": "Dutiyampi saṅghaṃ saraṇaṃ gacchāmi."
    },
    {
      "id": "s0501m:9",
      "pali": "Tatiyampi buddhaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:10",
      "pali": "Tatiyampi dhammaṃ saraṇaṃ gacchāmi;"
    },
    {
      "id": "s0501m:11",
      "pali": "Tatiyampi saṅghaṃ saraṇaṃ gacchāmi."
    },
    {
      "id": "s0501m:12",
      "pali": "Saraṇattayaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:13",
      "pali": "2. Dasasikkhāpadaṃ"
    },
    {
      "id": "s0501m:14",
      "pali": "1 . Pāṇātipātā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:15",
      "pali": "2 . Adinnādānā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:16",
      "pali": "3 . Abrahmacariyā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:17",
      "pali": "4 . Musāvādā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:18",
      "pali": "5 . Surāmerayamajjapamādaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi ."
    },
    {
      "id": "s0501m:19",
      "pali": "6 . Vikālabhojanā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:20",
      "pali": "7 . Nacca-gīta-vādita-visūkadassanā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:21",
      "pali": "8 . Mālā-gandha-vilepana-dhāraṇa-maṇḍana-vibhūsanaṭṭhānā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:22",
      "pali": "9 . Uccāsayana-mahāsayanā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:23",
      "pali": "10 . Jātarūpa-rajatapaṭiggahaṇā veramaṇī-sikkhāpadaṃ samādiyāmi."
    },
    {
      "id": "s0501m:24",
      "pali": "Dasasikkhāpadaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:25",
      "pali": "3. Dvattiṃsākāro"
    },
    {
      "id": "s0501m:26",
      "pali": "Atthi imasmiṃ kāye –"
    },
    {
      "id": "s0501m:27",
      "pali": "Kesā lomā nakhā dantā taco,"
    },
    {
      "id": "s0501m:28",
      "pali": "Maṃsaṃ nhāru aṭṭhi aṭṭhimiñjaṃ vakkaṃ,"
    },
    {
      "id": "s0501m:29",
      "pali": "Hadayaṃ yakanaṃ kilomakaṃ pihakaṃ papphāsaṃ,"
    },
    {
      "id": "s0501m:30",
      "pali": "Antaṃ antaguṇaṃ udariyaṃ karīsaṃ matthaluṅgaṃ ,"
    },
    {
      "id": "s0501m:31",
      "pali": "Pittaṃ semhaṃ pubbo lohitaṃ sedo medo,"
    },
    {
      "id": "s0501m:32",
      "pali": "Assu vasā kheḷo siṅghāṇikā lasikā muttanti ."
    },
    {
      "id": "s0501m:33",
      "pali": "Dvattiṃsākāro niṭṭhito."
    },
    {
      "id": "s0501m:34",
      "pali": "4. Kumārapañhā"
    },
    {
      "id": "s0501m:35",
      "pali": "1 . ‘‘Ekaṃ nāma kiṃ’’? ‘‘Sabbe sattā āhāraṭṭhitikā’’."
    },
    {
      "id": "s0501m:36",
      "pali": "2 . ‘‘Dve nāma kiṃ’’? ‘‘Nāmañca rūpañca’’."
    },
    {
      "id": "s0501m:37",
      "pali": "3 . ‘‘Tīṇi nāma kiṃ’’? ‘‘Tisso vedanā’’."
    },
    {
      "id": "s0501m:38",
      "pali": "4 . ‘‘Cattāri nāma kiṃ’’? ‘‘Cattāri ariyasaccāni’’."
    },
    {
      "id": "s0501m:39",
      "pali": "5 . ‘‘Pañca nāma kiṃ’’? ‘‘Pañcupādānakkhandhā’’."
    },
    {
      "id": "s0501m:40",
      "pali": "6 . ‘‘Cha nāma kiṃ’’? ‘‘Cha ajjhattikāni āyatanāni’’."
    },
    {
      "id": "s0501m:41",
      "pali": "7 . ‘‘Satta nāma kiṃ’’? ‘‘Satta bojjhaṅgā’’."
    },
    {
      "id": "s0501m:42",
      "pali": "8 . ‘‘Aṭṭha nāma kiṃ’’? ‘‘Ariyo aṭṭhaṅgiko maggo’’."
    },
    {
      "id": "s0501m:43",
      "pali": "9 . ‘‘Nava nāma kiṃ’’? ‘‘Nava sattāvāsā’’."
    },
    {
      "id": "s0501m:44",
      "pali": "10 . ‘‘Dasa nāma kiṃ’’? ‘‘Dasahaṅgehi samannāgato ‘arahā’ti vuccatī’’ti."
    },
    {
      "id": "s0501m:45",
      "pali": "Kumārapañhā niṭṭhitā."
    },
    {
      "id": "s0501m:46",
      "pali": "5. Maṅgalasuttaṃ"
    },
    {
      "id": "s0501m:47",
      "pali": "1 . Evaṃ me sutaṃ – ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme. Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi –"
    },
    {
      "id": "s0501m:48",
      "pali": "2 ."
    },
    {
      "id": "s0501m:49",
      "pali": "‘‘Bahū devā manussā ca, maṅgalāni acintayuṃ;"
    },
    {
      "id": "s0501m:50",
      "pali": "Ākaṅkhamānā sotthānaṃ, brūhi maṅgalamuttamaṃ’’."
    },
    {
      "id": "s0501m:51",
      "pali": "3 ."
    },
    {
      "id": "s0501m:52",
      "pali": "‘‘Asevanā ca bālānaṃ, paṇḍitānañca sevanā;"
    },
    {
      "id": "s0501m:53",
      "pali": "Pūjā ca pūjaneyyānaṃ , etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:54",
      "pali": "4 ."
    },
    {
      "id": "s0501m:55",
      "pali": "‘‘Patirūpadesavāso ca, pubbe ca katapuññatā;"
    },
    {
      "id": "s0501m:56",
      "pali": "Attasammāpaṇidhi ca, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:57",
      "pali": "5 ."
    },
    {
      "id": "s0501m:58",
      "pali": "‘‘Bāhusaccañca sippañca, vinayo ca susikkhito;"
    },
    {
      "id": "s0501m:59",
      "pali": "Subhāsitā ca yā vācā, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:60",
      "pali": "6 ."
    },
    {
      "id": "s0501m:61",
      "pali": "‘‘Mātāpitu upaṭṭhānaṃ, puttadārassa saṅgaho;"
    },
    {
      "id": "s0501m:62",
      "pali": "Anākulā ca kammantā, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:63",
      "pali": "7 ."
    },
    {
      "id": "s0501m:64",
      "pali": "‘‘Dānañca dhammacariyā ca, ñātakānañca saṅgaho;"
    },
    {
      "id": "s0501m:65",
      "pali": "Anavajjāni kammāni, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:66",
      "pali": "8 ."
    },
    {
      "id": "s0501m:67",
      "pali": "‘‘Āratī viratī pāpā, majjapānā ca saṃyamo;"
    },
    {
      "id": "s0501m:68",
      "pali": "Appamādo ca dhammesu, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:69",
      "pali": "9 ."
    },
    {
      "id": "s0501m:70",
      "pali": "‘‘Gāravo ca nivāto ca, santuṭṭhi ca kataññutā;"
    },
    {
      "id": "s0501m:71",
      "pali": "Kālena dhammassavanaṃ , etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:72",
      "pali": "10 ."
    },
    {
      "id": "s0501m:73",
      "pali": "‘‘Khantī ca sovacassatā, samaṇānañca dassanaṃ;"
    },
    {
      "id": "s0501m:74",
      "pali": "Kālena dhammasākacchā, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:75",
      "pali": "11 ."
    },
    {
      "id": "s0501m:76",
      "pali": "‘‘Tapo ca brahmacariyañca, ariyasaccāna dassanaṃ;"
    },
    {
      "id": "s0501m:77",
      "pali": "Nibbānasacchikiriyā ca, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:78",
      "pali": "12 ."
    },
    {
      "id": "s0501m:79",
      "pali": "‘‘Phuṭṭhassa lokadhammehi, cittaṃ yassa na kampati;"
    },
    {
      "id": "s0501m:80",
      "pali": "Asokaṃ virajaṃ khemaṃ, etaṃ maṅgalamuttamaṃ."
    },
    {
      "id": "s0501m:81",
      "pali": "13 ."
    },
    {
      "id": "s0501m:82",
      "pali": "‘‘Etādisāni katvāna, sabbatthamaparājitā;"
    },
    {
      "id": "s0501m:83",
      "pali": "Sabbattha sotthiṃ gacchanti, taṃ tesaṃ maṅgalamuttama’’nti."
    },
    {
      "id": "s0501m:84",
      "pali": "Maṅgalasuttaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:85",
      "pali": "6. Ratanasuttaṃ"
    },
    {
      "id": "s0501m:86",
      "pali": "1 ."
    },
    {
      "id": "s0501m:87",
      "pali": "Yānīdha bhūtāni samāgatāni, bhummāni vā yāni va antalikkhe;"
    },
    {
      "id": "s0501m:88",
      "pali": "Sabbeva bhūtā sumanā bhavantu, athopi sakkacca suṇantu bhāsitaṃ."
    },
    {
      "id": "s0501m:89",
      "pali": "2 ."
    },
    {
      "id": "s0501m:90",
      "pali": "Tasmā hi bhūtā nisāmetha sabbe, mettaṃ karotha mānusiyā pajāya;"
    },
    {
      "id": "s0501m:91",
      "pali": "Divā ca ratto ca haranti ye baliṃ, tasmā hi ne rakkhatha appamattā."
    },
    {
      "id": "s0501m:92",
      "pali": "3 ."
    },
    {
      "id": "s0501m:93",
      "pali": "Yaṃ kiñci vittaṃ idha vā huraṃ vā, saggesu vā yaṃ ratanaṃ paṇītaṃ;"
    },
    {
      "id": "s0501m:94",
      "pali": "Na no samaṃ atthi tathāgatena, idampi buddhe ratanaṃ paṇītaṃ;"
    },
    {
      "id": "s0501m:95",
      "pali": "Etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:96",
      "pali": "4 ."
    },
    {
      "id": "s0501m:97",
      "pali": "Khayaṃ virāgaṃ amataṃ paṇītaṃ, yadajjhagā sakyamunī samāhito;"
    },
    {
      "id": "s0501m:98",
      "pali": "Na tena dhammena samatthi kiñci, idampi dhamme ratanaṃ paṇītaṃ;"
    },
    {
      "id": "s0501m:99",
      "pali": "Etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:100",
      "pali": "5 ."
    },
    {
      "id": "s0501m:101",
      "pali": "Yaṃ buddhaseṭṭho parivaṇṇayī suciṃ, samādhimānantarikaññamāhu;"
    },
    {
      "id": "s0501m:102",
      "pali": "Samādhinā tena samo na vijjati, idampi dhamme ratanaṃ paṇītaṃ;"
    },
    {
      "id": "s0501m:103",
      "pali": "Etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:104",
      "pali": "6 ."
    },
    {
      "id": "s0501m:105",
      "pali": "Ye puggalā aṭṭha sataṃ pasatthā, cattāri etāni yugāni honti;"
    },
    {
      "id": "s0501m:106",
      "pali": "Te dakkhiṇeyyā sugatassa sāvakā, etesu dinnāni mahapphalāni;"
    },
    {
      "id": "s0501m:107",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:108",
      "pali": "7 ."
    },
    {
      "id": "s0501m:109",
      "pali": "Ye suppayuttā manasā daḷhena, nikkāmino gotamasāsanamhi;"
    },
    {
      "id": "s0501m:110",
      "pali": "Te pattipattā amataṃ vigayha, laddhā mudhā nibbutiṃ bhuñjamānā;"
    },
    {
      "id": "s0501m:111",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:112",
      "pali": "8 ."
    },
    {
      "id": "s0501m:113",
      "pali": "Yathindakhīlo pathavissito siyā, catubbhi vātehi asampakampiyo;"
    },
    {
      "id": "s0501m:114",
      "pali": "Tathūpamaṃ sappurisaṃ vadāmi, yo ariyasaccāni avecca passati;"
    },
    {
      "id": "s0501m:115",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:116",
      "pali": "9 ."
    },
    {
      "id": "s0501m:117",
      "pali": "Ye ariyasaccāni vibhāvayanti, gambhīrapaññena sudesitāni;"
    },
    {
      "id": "s0501m:118",
      "pali": "Kiñcāpi te honti bhusaṃ pamattā, na te bhavaṃ aṭṭhamamādiyanti;"
    },
    {
      "id": "s0501m:119",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:120",
      "pali": "10 ."
    },
    {
      "id": "s0501m:121",
      "pali": "Sahāvassa dassanasampadāya , tayassu dhammā jahitā bhavanti;"
    },
    {
      "id": "s0501m:122",
      "pali": "Sakkāyadiṭṭhī vicikicchitañca, sīlabbataṃ vāpi yadatthi kiñci."
    },
    {
      "id": "s0501m:123",
      "pali": "11 ."
    },
    {
      "id": "s0501m:124",
      "pali": "Catūhapāyehi ca vippamutto, chaccābhiṭhānāni abhabba kātuṃ ;"
    },
    {
      "id": "s0501m:125",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:126",
      "pali": "12 ."
    },
    {
      "id": "s0501m:127",
      "pali": "Kiñcāpi so kamma karoti pāpakaṃ, kāyena vācā uda cetasā vā;"
    },
    {
      "id": "s0501m:128",
      "pali": "Abhabba so tassa paṭicchadāya , abhabbatā diṭṭhapadassa vuttā;"
    },
    {
      "id": "s0501m:129",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:130",
      "pali": "13 ."
    },
    {
      "id": "s0501m:131",
      "pali": "Vanappagumbe yatha phussitagge, gimhānamāse paṭhamasmiṃ gimhe;"
    },
    {
      "id": "s0501m:132",
      "pali": "Tathūpamaṃ dhammavaraṃ adesayi , nibbānagāmiṃ paramaṃ hitāya;"
    },
    {
      "id": "s0501m:133",
      "pali": "Idampi buddhe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:134",
      "pali": "14 ."
    },
    {
      "id": "s0501m:135",
      "pali": "Varo varaññū varado varāharo, anuttaro dhammavaraṃ adesayi;"
    },
    {
      "id": "s0501m:136",
      "pali": "Idampi buddhe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:137",
      "pali": "15 ."
    },
    {
      "id": "s0501m:138",
      "pali": "Khīṇaṃ purāṇaṃ nava natthi sambhavaṃ, virattacittāyatike bhavasmiṃ;"
    },
    {
      "id": "s0501m:139",
      "pali": "Te khīṇabījā avirūḷhichandā, nibbanti dhīrā yathāyaṃ padīpo;"
    },
    {
      "id": "s0501m:140",
      "pali": "Idampi saṅghe ratanaṃ paṇītaṃ, etena saccena suvatthi hotu."
    },
    {
      "id": "s0501m:141",
      "pali": "16 ."
    },
    {
      "id": "s0501m:142",
      "pali": "Yānīdha bhūtāni samāgatāni, bhummāni vā yāni va antalikkhe;"
    },
    {
      "id": "s0501m:143",
      "pali": "Tathāgataṃ devamanussapūjitaṃ, buddhaṃ namassāma suvatthi hotu."
    },
    {
      "id": "s0501m:144",
      "pali": "17 ."
    },
    {
      "id": "s0501m:145",
      "pali": "Yānīdha bhūtāni samāgatāni, bhummāni vā yāni va antalikkhe;"
    },
    {
      "id": "s0501m:146",
      "pali": "Tathāgataṃ devamanussapūjitaṃ, dhammaṃ namassāma suvatthi hotu."
    },
    {
      "id": "s0501m:147",
      "pali": "18 ."
    },
    {
      "id": "s0501m:148",
      "pali": "Yānīdha bhūtāni samāgatāni, bhummāni vā yāni va antalikkhe;"
    },
    {
      "id": "s0501m:149",
      "pali": "Tathāgataṃ devamanussapūjitaṃ, saṅghaṃ namassāma suvatthi hotūti."
    },
    {
      "id": "s0501m:150",
      "pali": "Ratanasuttaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:151",
      "pali": "7. Tirokuṭṭasuttaṃ"
    },
    {
      "id": "s0501m:152",
      "pali": "1 ."
    },
    {
      "id": "s0501m:153",
      "pali": "Tirokuṭṭesu tiṭṭhanti, sandhisiṅghāṭakesu ca;"
    },
    {
      "id": "s0501m:154",
      "pali": "Dvārabāhāsu tiṭṭhanti, āgantvāna sakaṃ gharaṃ."
    },
    {
      "id": "s0501m:155",
      "pali": "2 ."
    },
    {
      "id": "s0501m:156",
      "pali": "Pahūte annapānamhi, khajjabhojje upaṭṭhite;"
    },
    {
      "id": "s0501m:157",
      "pali": "Na tesaṃ koci sarati, sattānaṃ kammapaccayā."
    },
    {
      "id": "s0501m:158",
      "pali": "3 ."
    },
    {
      "id": "s0501m:159",
      "pali": "Evaṃ dadanti ñātīnaṃ, ye honti anukampakā;"
    },
    {
      "id": "s0501m:160",
      "pali": "Suciṃ paṇītaṃ kālena, kappiyaṃ pānabhojanaṃ;"
    },
    {
      "id": "s0501m:161",
      "pali": "Idaṃ vo ñātīnaṃ hotu, sukhitā hontu ñātayo."
    },
    {
      "id": "s0501m:162",
      "pali": "4 ."
    },
    {
      "id": "s0501m:163",
      "pali": "Te ca tattha samāgantvā, ñātipetā samāgatā;"
    },
    {
      "id": "s0501m:164",
      "pali": "Pahūte annapānamhi, sakkaccaṃ anumodare."
    },
    {
      "id": "s0501m:165",
      "pali": "5 ."
    },
    {
      "id": "s0501m:166",
      "pali": "Ciraṃ jīvantu no ñātī, yesaṃ hetu labhāmase;"
    },
    {
      "id": "s0501m:167",
      "pali": "Amhākañca katā pūjā, dāyakā ca anipphalā."
    },
    {
      "id": "s0501m:168",
      "pali": "6 ."
    },
    {
      "id": "s0501m:169",
      "pali": "Na hi tattha kasi atthi, gorakkhettha na vijjati;"
    },
    {
      "id": "s0501m:170",
      "pali": "Vaṇijjā tādisī natthi, hiraññena kayokayaṃ ;"
    },
    {
      "id": "s0501m:171",
      "pali": "Ito dinnena yāpenti, petā kālaṅkatā tahiṃ."
    },
    {
      "id": "s0501m:172",
      "pali": "7 ."
    },
    {
      "id": "s0501m:173",
      "pali": "Unname udakaṃ vuṭṭhaṃ, yathā ninnaṃ pavattati;"
    },
    {
      "id": "s0501m:174",
      "pali": "Evameva ito dinnaṃ, petānaṃ upakappati."
    },
    {
      "id": "s0501m:175",
      "pali": "8 ."
    },
    {
      "id": "s0501m:176",
      "pali": "Yathā vārivahā pūrā, paripūrenti sāgaraṃ;"
    },
    {
      "id": "s0501m:177",
      "pali": "Evameva ito dinnaṃ, petānaṃ upakappati."
    },
    {
      "id": "s0501m:178",
      "pali": "9 ."
    },
    {
      "id": "s0501m:179",
      "pali": "Adāsi me akāsi me, ñātimittā sakhā ca me;"
    },
    {
      "id": "s0501m:180",
      "pali": "Petānaṃ dakkhiṇaṃ dajjā, pubbe katamanussaraṃ."
    },
    {
      "id": "s0501m:181",
      "pali": "10 ."
    },
    {
      "id": "s0501m:182",
      "pali": "Na hi ruṇṇaṃ vā soko vā, yā caññā paridevanā;"
    },
    {
      "id": "s0501m:183",
      "pali": "Na taṃ petānamatthāya, evaṃ tiṭṭhanti ñātayo."
    },
    {
      "id": "s0501m:184",
      "pali": "11 ."
    },
    {
      "id": "s0501m:185",
      "pali": "Ayañca kho dakkhiṇā dinnā, saṅghamhi suppatiṭṭhitā;"
    },
    {
      "id": "s0501m:186",
      "pali": "Dīgharattaṃ hitāyassa, ṭhānaso upakappati."
    },
    {
      "id": "s0501m:187",
      "pali": "12 ."
    },
    {
      "id": "s0501m:188",
      "pali": "So ñātidhammo ca ayaṃ nidassito, petāna pūjā ca katā uḷārā;"
    },
    {
      "id": "s0501m:189",
      "pali": "Balañca bhikkhūnamanuppadinnaṃ , tumhehi puññaṃ pasutaṃ anappakanti."
    },
    {
      "id": "s0501m:190",
      "pali": "Tirokuṭṭasuttaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:191",
      "pali": "8. Nidhikaṇḍasuttaṃ"
    },
    {
      "id": "s0501m:192",
      "pali": "1 ."
    },
    {
      "id": "s0501m:193",
      "pali": "Nidhiṃ nidheti puriso, gambhīre odakantike;"
    },
    {
      "id": "s0501m:194",
      "pali": "Atthe kicce samuppanne, atthāya me bhavissati."
    },
    {
      "id": "s0501m:195",
      "pali": "2 ."
    },
    {
      "id": "s0501m:196",
      "pali": "Rājato vā duruttassa, corato pīḷitassa vā;"
    },
    {
      "id": "s0501m:197",
      "pali": "Iṇassa vā pamokkhāya, dubbhikkhe āpadāsu vā;"
    },
    {
      "id": "s0501m:198",
      "pali": "Etadatthāya lokasmiṃ, nidhi nāma nidhīyati."
    },
    {
      "id": "s0501m:199",
      "pali": "3 ."
    },
    {
      "id": "s0501m:200",
      "pali": "Tāvassunihito santo, gambhīre odakantike;"
    },
    {
      "id": "s0501m:201",
      "pali": "Na sabbo sabbadā eva, tassa taṃ upakappati."
    },
    {
      "id": "s0501m:202",
      "pali": "4 ."
    },
    {
      "id": "s0501m:203",
      "pali": "Nidhi vā ṭhānā cavati, saññā vāssa vimuyhati;"
    },
    {
      "id": "s0501m:204",
      "pali": "Nāgā vā apanāmenti, yakkhā vāpi haranti naṃ."
    },
    {
      "id": "s0501m:205",
      "pali": "5 ."
    },
    {
      "id": "s0501m:206",
      "pali": "Appiyā vāpi dāyādā, uddharanti apassato;"
    },
    {
      "id": "s0501m:207",
      "pali": "Yadā puññakkhayo hoti, sabbametaṃ vinassati."
    },
    {
      "id": "s0501m:208",
      "pali": "6 ."
    },
    {
      "id": "s0501m:209",
      "pali": "Yassa dānena sīlena, saṃyamena damena ca;"
    },
    {
      "id": "s0501m:210",
      "pali": "Nidhī sunihito hoti, itthiyā purisassa vā."
    },
    {
      "id": "s0501m:211",
      "pali": "7 ."
    },
    {
      "id": "s0501m:212",
      "pali": "Cetiyamhi ca saṅghe vā, puggale atithīsu vā;"
    },
    {
      "id": "s0501m:213",
      "pali": "Mātari pitari cāpi , atho jeṭṭhamhi bhātari."
    },
    {
      "id": "s0501m:214",
      "pali": "8 ."
    },
    {
      "id": "s0501m:215",
      "pali": "Eso nidhi sunihito, ajeyyo anugāmiko;"
    },
    {
      "id": "s0501m:216",
      "pali": "Pahāya gamanīyesu, etaṃ ādāya gacchati."
    },
    {
      "id": "s0501m:217",
      "pali": "9 ."
    },
    {
      "id": "s0501m:218",
      "pali": "Asādhāraṇamaññesaṃ, acorāharaṇo nidhi;"
    },
    {
      "id": "s0501m:219",
      "pali": "Kayirātha dhīro puññāni, yo nidhi anugāmiko."
    },
    {
      "id": "s0501m:220",
      "pali": "10 ."
    },
    {
      "id": "s0501m:221",
      "pali": "Esa devamanussānaṃ, sabbakāmadado nidhi;"
    },
    {
      "id": "s0501m:222",
      "pali": "Yaṃ yadevābhipatthenti, sabbametena labbhati."
    },
    {
      "id": "s0501m:223",
      "pali": "11 ."
    },
    {
      "id": "s0501m:224",
      "pali": "Suvaṇṇatā susaratā, susaṇṭhānā surūpatā ;"
    },
    {
      "id": "s0501m:225",
      "pali": "Ādhipaccaparivāro, sabbametena labbhati."
    },
    {
      "id": "s0501m:226",
      "pali": "12 ."
    },
    {
      "id": "s0501m:227",
      "pali": "Padesarajjaṃ issariyaṃ, cakkavattisukhaṃ piyaṃ;"
    },
    {
      "id": "s0501m:228",
      "pali": "Devarajjampi dibbesu, sabbametena labbhati."
    },
    {
      "id": "s0501m:229",
      "pali": "13 ."
    },
    {
      "id": "s0501m:230",
      "pali": "Mānussikā ca sampatti, devaloke ca yā rati;"
    },
    {
      "id": "s0501m:231",
      "pali": "Yā ca nibbānasampatti, sabbametena labbhati."
    },
    {
      "id": "s0501m:232",
      "pali": "14 ."
    },
    {
      "id": "s0501m:233",
      "pali": "Mittasampadamāgamma, yonisova payuñjato;"
    },
    {
      "id": "s0501m:234",
      "pali": "Vijjā vimutti vasībhāvo, sabbametena labbhati."
    },
    {
      "id": "s0501m:235",
      "pali": "15 ."
    },
    {
      "id": "s0501m:236",
      "pali": "Paṭisambhidā vimokkhā ca, yā ca sāvakapāramī;"
    },
    {
      "id": "s0501m:237",
      "pali": "Paccekabodhi buddhabhūmi, sabbametena labbhati."
    },
    {
      "id": "s0501m:238",
      "pali": "16 ."
    },
    {
      "id": "s0501m:239",
      "pali": "Evaṃ mahatthikā esā, yadidaṃ puññasampadā;"
    },
    {
      "id": "s0501m:240",
      "pali": "Tasmā dhīrā pasaṃsanti, paṇḍitā katapuññatanti."
    },
    {
      "id": "s0501m:241",
      "pali": "Nidhikaṇḍasuttaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:242",
      "pali": "9. Mettasuttaṃ"
    },
    {
      "id": "s0501m:243",
      "pali": "1 ."
    },
    {
      "id": "s0501m:244",
      "pali": "Karaṇīyamatthakusalena , yantasantaṃ padaṃ abhisamecca;"
    },
    {
      "id": "s0501m:245",
      "pali": "Sakko ujū ca suhujū ca, suvaco cassa mudu anatimānī."
    },
    {
      "id": "s0501m:246",
      "pali": "2 ."
    },
    {
      "id": "s0501m:247",
      "pali": "Santussako ca subharo ca, appakicco ca sallahukavutti;"
    },
    {
      "id": "s0501m:248",
      "pali": "Santindriyo ca nipako ca, appagabbho kulesvananugiddho."
    },
    {
      "id": "s0501m:249",
      "pali": "3 ."
    },
    {
      "id": "s0501m:250",
      "pali": "Na ca khuddamācare kiñci, yena viññū pare upavadeyyuṃ;"
    },
    {
      "id": "s0501m:251",
      "pali": "Sukhinova khemino hontu, sabbasattā bhavantu sukhitattā."
    },
    {
      "id": "s0501m:252",
      "pali": "4 ."
    },
    {
      "id": "s0501m:253",
      "pali": "Ye keci pāṇabhūtatthi, tasā vā thāvarā vanavasesā;"
    },
    {
      "id": "s0501m:254",
      "pali": "Dīghā vā yeva mahantā , majjhimā rassakā aṇukathūlā."
    },
    {
      "id": "s0501m:255",
      "pali": "5 ."
    },
    {
      "id": "s0501m:256",
      "pali": "Diṭṭhā vā yeva adiṭṭhā , ye va dūre vasanti avidūre;"
    },
    {
      "id": "s0501m:257",
      "pali": "Bhūtā va sambhavesī va , sabbasattā bhavantu sukhitattā."
    },
    {
      "id": "s0501m:258",
      "pali": "6 ."
    },
    {
      "id": "s0501m:259",
      "pali": "Na paro paraṃ nikubbetha, nātimaññetha katthaci na kañci ;"
    },
    {
      "id": "s0501m:260",
      "pali": "Byārosanā paṭighasaññā, nāññamaññassa dukkhamiccheyya."
    },
    {
      "id": "s0501m:261",
      "pali": "7 ."
    },
    {
      "id": "s0501m:262",
      "pali": "Mātā yathā niyaṃ puttamāyusā ekaputtamanurakkhe;"
    },
    {
      "id": "s0501m:263",
      "pali": "Evampi sabbabhūtesu, mānasaṃ bhāvaye aparimāṇaṃ."
    },
    {
      "id": "s0501m:264",
      "pali": "8 ."
    },
    {
      "id": "s0501m:265",
      "pali": "Mettañca sabbalokasmi, mānasaṃ bhāvaye aparimāṇaṃ;"
    },
    {
      "id": "s0501m:266",
      "pali": "Uddhaṃ adho ca tiriyañca, asambādhaṃ averamasapattaṃ."
    },
    {
      "id": "s0501m:267",
      "pali": "9 ."
    },
    {
      "id": "s0501m:268",
      "pali": "Tiṭṭhaṃ caraṃ nisinno va , sayāno yāvatāssa vitamiddho ;"
    },
    {
      "id": "s0501m:269",
      "pali": "Etaṃ satiṃ adhiṭṭheyya, brahmametaṃ vihāramidhamāhu."
    },
    {
      "id": "s0501m:270",
      "pali": "10 ."
    },
    {
      "id": "s0501m:271",
      "pali": "Diṭṭhiñca anupaggamma, sīlavā dassanena sampanno;"
    },
    {
      "id": "s0501m:272",
      "pali": "Kāmesu vinaya gedhaṃ, na hi jātuggabbhaseyya puna retīti."
    },
    {
      "id": "s0501m:273",
      "pali": "Mettasuttaṃ niṭṭhitaṃ."
    },
    {
      "id": "s0501m:274",
      "pali": "Khuddakapāṭhapāḷi niṭṭhitā."
    }
  ]
}